{
  "name": "pixel-pc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Cozy Pixel-Art AI Computer Simulation Game with 9Router Integration",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "concurrently -k \"vite\" \"npm run build:electron && electron .\"",
    "electron:pack": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.7",
    "phaser": "^3.88.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^5.1.10",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "main": "electron/dist/main.cjs"
}
