# ========================================================
# Pixel PC — Environment Configuration (Vercel & Local)
# NOTE: Semua key di bawah TIDAK menggunakan angka agar
# sepenuhnya valid dan bisa disimpan di Vercel Environment Variables.
# ========================================================

# Gateway Base URL
# Local development: http://127.0.0.1:20128/v1
# Vercel production: https://<your-tunnel-or-domain>.abc-tunnel.us/v1
ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Optional Server-Held API Key (sk-...)
# Jika dikosongkan, user bisa memasukkannya sendiri lewat jendela Settings di dalam game.
ROUTER_API_KEY=

# Default AI Model ID
DEFAULT_MODEL=ag/gemini-3.8-flash-medium

# Optional Allowed Origins untuk CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
