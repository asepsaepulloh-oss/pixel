# ========================================================
# Pixel PC — Environment Configuration
# ========================================================

# 9Router Gateway Base URL
# For local development: http://127.0.0.1:20128/v1
# For Vercel production: Set to an externally reachable HTTPS 9Router or OpenAI-compatible URL
9ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Optional Server-Held 9Router API Key
# If omitted, clients provide their own session key via the in-game Settings UI.
9ROUTER_API_KEY=

# Default AI Model (exactly: ag/gemini-3.8-flash-medium)
DEFAULT_MODEL=ag/gemini-3.8-flash-medium

# Optional Allowed Origins for CORS / Reverse Proxy Protection
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
